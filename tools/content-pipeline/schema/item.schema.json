{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "itemId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "trackCode": {
      "type": "string",
      "enum": [
        "TECH_FULLSTACK",
        "TECH_AIML",
        "TECH_CLOUD_DEVOPS",
        "TECH_CYBERSECURITY",
        "TECH_DATA_ANALYST",
        "MBA_FINANCE",
        "MBA_BUSINESS_ANALYTICS",
        "MBA_MARKETING",
        "MBA_OPERATIONS",
        "MBA_HR"
      ]
    },
    "domainCode": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "levelNumber": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "number",
          "const": 5
        }
      ]
    },
    "competencyId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "itemType": {
      "type": "string",
      "enum": [
        "MCQ_SINGLE",
        "MCQ_MULTI",
        "NUMERIC_ENTRY",
        "SHORT_ANSWER",
        "CODE_TASK",
        "SQL_TASK",
        "SCENARIO_RESPONSE",
        "SPOKEN_RESPONSE",
        "DEFENSE_PROMPT",
        "ARTIFACT_UPLOAD"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": ["EASY", "MEDIUM", "HARD", "EXPERT"]
    },
    "promptText": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "optionId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": ["optionId", "label"],
        "additionalProperties": false
      }
    },
    "correctOptionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedNumericAnswer": {
      "type": "number"
    },
    "numericTolerance": {
      "type": "number"
    },
    "starterCode": {
      "type": "string"
    },
    "runtime": {
      "type": "string",
      "enum": ["node", "python", "postgres"]
    },
    "modelAnswer": {
      "type": "string"
    },
    "checklistCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "points": {
            "type": "number"
          }
        },
        "required": ["id", "text", "points"],
        "additionalProperties": false
      }
    },
    "sandboxTestCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "expectedOutput": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "required": ["id", "input", "expectedOutput", "hidden"],
        "additionalProperties": false
      }
    },
    "maxResponseSeconds": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "attachmentUrl": {
      "type": "string",
      "format": "uri"
    },
    "itemWeight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "itemId",
    "trackCode",
    "domainCode",
    "levelNumber",
    "competencyId",
    "itemType",
    "difficulty",
    "promptText",
    "itemWeight"
  ],
  "additionalProperties": false
}
