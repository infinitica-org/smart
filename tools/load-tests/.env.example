# Copy to tools/load-tests/.env for local overrides. Never commit a filled
# file — k6 doesn't auto-load .env, so export these or pass via `-e`/`--env-file`
# (k6 v0.50+ supports `k6 run --env-file .env`).

# --- targets ---
BASE_URL=http://localhost:3001
API_URL=http://localhost:3000
APP_STUDENT_URL=http://localhost:3001
APP_TPO_URL=http://localhost:3002
APP_ADMIN_URL=http://localhost:3003
APP_VERIFY_URL=http://localhost:3004
AUTH_URL=http://localhost:3005

# --- credentials (local/dev seed data only — never real credentials) ---
TEST_USERNAME=student@smart.local
TEST_PASSWORD=ChangeMe!Dev
TEST_TPO_USERNAME=tpo@smart.local
TEST_TPO_PASSWORD=ChangeMe!Dev

# Bulk load-test accounts — seed with:
#   pnpm --filter @smart/api-core db:seed:load-test
TEST_DATA_USERS=200
TEST_DATA_TRACK_CODE=TECH_FULLSTACK

# --- safety (see README "Production safety") ---
ALLOW_PRODUCTION_LOAD_TEST=false
CONFIRM_PRODUCTION_LOAD_TEST=false
ALLOW_AI_EVAL_LOAD=false

# --- traffic mix (must sum to 100 — config/index.js throws otherwise) ---
TRAFFIC_BROWSING_PCT=50
TRAFFIC_SEARCH_PCT=20
TRAFFIC_API_READS_PCT=15
TRAFFIC_WRITES_PCT=8
TRAFFIC_BUSINESS_FLOW_PCT=7

# --- thresholds ---
THRESHOLD_HTTP_FAILED_RATE=0.01
THRESHOLD_FRONTEND_P95_MS=500
THRESHOLD_API_P95_MS=500
THRESHOLD_API_P99_MS=1000
THRESHOLD_BUSINESS_FLOW_P95_MS=1500
THRESHOLD_AUTH_P95_MS=200
THRESHOLD_SEARCH_P95_MS=300
THRESHOLD_WRITES_P95_MS=200

# --- profile sizing (all optional; defaults live in each tests/*.js file) ---
SMOKE_VUS=15
SMOKE_DURATION=3m
BASELINE_VUS=100
BASELINE_DURATION=20m
# "target:duration,target:duration,..." — see config/stages.js
LOAD_STAGES=100:2m,200:2m,500:3m,1000:3m,2000:5m
STRESS_STAGES=100:2m,500:2m,1000:2m,2000:2m,3000:2m,5000:3m
EXECUTOR_MODE=vus
SPIKE_BASE_VUS=100
SPIKE_PEAK_VUS=5000
SOAK_VUS=1000
SOAK_DURATION=4h

# --- k6 -> Prometheus remote-write (optional; scripts/run-k6.sh sets this when the obs profile is up) ---
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9090/api/v1/write
K6_PROMETHEUS_RW_TREND_STATS=p(50),p(95),p(99),avg,min,max
