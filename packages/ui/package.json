{
  "name": "@smart/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React component library and SMART design system. Consumed as source via Next transpilePackages. Owner: Satheswaran V.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@smart/contracts": "workspace:*",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@smart/eslint-config": "workspace:*",
    "@smart/tailwind-config": "workspace:*",
    "@smart/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "rimraf": "6.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
