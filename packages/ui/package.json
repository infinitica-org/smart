{
  "name": "@smart/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React component library and SMART design system. Consumed as source via Next transpilePackages. Owner: Satheswaran V.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@smart/api-client": "workspace:*",
    "@smart/contracts": "workspace:*",
    "@smart/tailwind-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@smart/eslint-config": "workspace:*",
    "@smart/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "catalog:",
    "jsdom": "^30.0.1",
    "react": "catalog:",
    "rimraf": "6.0.1",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
