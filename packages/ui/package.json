{
  "name": "@smart/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React component library and SMART design system. Consumed as source via Next transpilePackages. Owner: Satheswaran V.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./assets/*": "./src/assets/*",
    "./assets/brand/*": "./src/assets/brand/*",
    "./utils": "./src/lib/cn.ts",
    "./theme-provider": "./src/components/theme-provider.tsx",
    "./theme-switcher": "./src/components/theme-switcher.tsx",
    "./hooks/use-mobile": "./src/hooks/use-mobile.ts",
    "./alert": "./src/components/ui/alert.tsx",
    "./avatar": "./src/components/ui/avatar.tsx",
    "./badge": "./src/components/ui/badge.tsx",
    "./button": "./src/components/ui/button.tsx",
    "./card": "./src/components/ui/card.tsx",
    "./checkbox": "./src/components/ui/checkbox.tsx",
    "./collapsible": "./src/components/ui/collapsible.tsx",
    "./command": "./src/components/ui/command.tsx",
    "./dialog": "./src/components/ui/dialog.tsx",
    "./dropdown-menu": "./src/components/ui/dropdown-menu.tsx",
    "./input": "./src/components/ui/input.tsx",
    "./input-group": "./src/components/ui/input-group.tsx",
    "./kbd": "./src/components/ui/kbd.tsx",
    "./label": "./src/components/ui/label.tsx",
    "./progress": "./src/components/ui/progress.tsx",
    "./scroll-area": "./src/components/ui/scroll-area.tsx",
    "./select": "./src/components/ui/select.tsx",
    "./separator": "./src/components/ui/separator.tsx",
    "./sheet": "./src/components/ui/sheet.tsx",
    "./sidebar": "./src/components/ui/sidebar.tsx",
    "./skeleton": "./src/components/ui/skeleton.tsx",
    "./sonner": "./src/components/ui/sonner.tsx",
    "./switch": "./src/components/ui/switch.tsx",
    "./table": "./src/components/ui/table.tsx",
    "./tabs": "./src/components/ui/tabs.tsx",
    "./textarea": "./src/components/ui/textarea.tsx",
    "./tooltip": "./src/components/ui/tooltip.tsx"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@smart/api-client": "workspace:*",
    "@smart/contracts": "workspace:*",
    "@smart/tailwind-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "0.7.1",
    "clsx": "catalog:",
    "cmdk": "1.1.1",
    "lucide-react": "catalog:",
    "motion": "12.23.12",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "shadcn": "4.19.0",
    "sonner": "2.0.8",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@smart/eslint-config": "workspace:*",
    "@smart/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "catalog:",
    "jsdom": "^30.0.1",
    "react": "catalog:",
    "rimraf": "6.0.1",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
