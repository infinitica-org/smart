# kvm2 — development stack (branch: dev). Copy to .env.dev on the server.
# Caddy is OFF for this stack so qa can own :80/:443 on the same host.

SMART_ENV=dev
COMPOSE_PROJECT_NAME=smart-dev
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://smart:CHANGE_ME@127.0.0.1:5432/smart?schema=public
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://127.0.0.1:6380
KAFKA_BROKERS=127.0.0.1:19092

# Optional: point DATABASE_URL at a dedicated Supabase *dev* project instead of Docker Postgres.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS____
CORS_ORIGINS=http://kvm2:3001,http://kvm2:3002,http://kvm2:3003,http://kvm2:3004
NEXT_PUBLIC_API_URL=http://kvm2:3000
PUBLIC_API_URL=http://kvm2:3000

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=smart
S3_ACCESS_KEY=smart
S3_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=smart
MINIO_ROOT_PASSWORD=CHANGE_ME

ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_MONTHLY_CEILING_USD=500

API_HOST=api-dev.localhost
STUDENT_HOST=app-dev.localhost
TPO_HOST=tpo-dev.localhost
ADMIN_HOST=admin-dev.localhost
VERIFY_HOST=verify-dev.localhost

POSTGRES_PORT=5432
REDIS_PORT=6380
REDPANDA_PORT=19092
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
PRISMA_STUDIO_PORT=5555
API_PORT=3000
STUDENT_PORT=3001
TPO_PORT=3002
ADMIN_PORT=3003
VERIFY_PORT=3004

GRAFANA_PASSWORD=CHANGE_ME
LOG_LEVEL=info
LOG_PRETTY=false
