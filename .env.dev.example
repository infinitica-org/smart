# kvm2 — development stack (branch: dev). Copy to .env.dev on the server.
# Caddy is ON for this stack — it owns :80/:443 on kvm2 (dev.becomesmart.online).

SMART_ENV=dev
COMPOSE_PROJECT_NAME=smart-dev
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Note: containers ignore this and use the compose-internal `postgres:5432` host —
# this value is only for host-side tooling (SSH-tunneled psql/prisma studio, etc.).
# The api container's own runtime pool goes through the compose-internal
# `pgbouncer:6432` (transaction pooling) instead — computed from
# POSTGRES_PASSWORD below, nothing to set here. See DATABASE.md.
DATABASE_URL=postgresql://smart:CHANGE_ME@127.0.0.1:5432/smart?schema=public
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://127.0.0.1:6380
KAFKA_BROKERS=127.0.0.1:19092

JWT_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS____
# NODE_ENV=production above means the api container requires this even on dev.
METRICS_SCRAPE_TOKEN=CHANGE_ME_PROM_SCRAPE_TOKEN
CORS_ORIGINS=https://dev.becomesmart.online,https://dev.app.becomesmart.online,https://dev.tpo.becomesmart.online,https://dev.admin.becomesmart.online,https://dev.verify.becomesmart.online
NEXT_PUBLIC_API_URL=https://dev.api.becomesmart.online
PUBLIC_API_URL=https://dev.api.becomesmart.online

AUTH_APP_URL=https://dev.becomesmart.online
STUDENT_APP_URL=https://dev.app.becomesmart.online
TPO_APP_URL=https://dev.tpo.becomesmart.online
ADMIN_APP_URL=https://dev.admin.becomesmart.online

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=smart
S3_ACCESS_KEY=smart
S3_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=smart
MINIO_ROOT_PASSWORD=CHANGE_ME

ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
AI_MONTHLY_CEILING_USD=500

# --- CN-T01 onboarding: GitHub repo picker + LinkedIn identity verification ---
GITHUB_API_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# --- Caddy virtual hosts ---
API_HOST=dev.api.becomesmart.online
STUDENT_HOST=dev.app.becomesmart.online
TPO_HOST=dev.tpo.becomesmart.online
ADMIN_HOST=dev.admin.becomesmart.online
VERIFY_HOST=dev.verify.becomesmart.online
AUTH_HOST=dev.becomesmart.online

# --- DB admin UI (Prisma Studio + Adminer via Caddy, HTTP Basic Auth in front) ---
STUDIO_HOST=dev.studio.becomesmart.online
DB_HOST=dev.db.becomesmart.online
DB_BASIC_AUTH_USER=CHANGE_ME
# bcrypt hash — generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '<password>'
# IMPORTANT: Compose interpolates .env files — escape every literal $ in the hash as $$,
# or the bcrypt salt gets parsed as a variable reference and silently mangled.
DB_BASIC_AUTH_HASH=CHANGE_ME

POSTGRES_PORT=5432
REDIS_PORT=6380
REDPANDA_PORT=19092
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
PRISMA_STUDIO_PORT=5555
ADMINER_PORT=8080
API_PORT=3000
STUDENT_PORT=3001
TPO_PORT=3002
ADMIN_PORT=3003
VERIFY_PORT=3004
AUTH_PORT=3005

GRAFANA_PASSWORD=CHANGE_ME
LOG_LEVEL=info
LOG_PRETTY=false

# --- Backups (S6-VV-97; see docs/delivery/BACKUP_RESTORE.md) ---
# Nightly encrypted Postgres + MinIO backup to an S3-compatible bucket at a
# DIFFERENT provider than this VPS. Idle until BACKUP_ENABLED=true.
BACKUP_ENABLED=false
BACKUP_ENV_NAME=dev
# Cron in UTC. Default 20:30 UTC = 02:00 IST.
BACKUP_SCHEDULE="30 20 * * *"
# age PUBLIC key only (age1...). The private key stays offline with the key holders.
BACKUP_AGE_RECIPIENT=
# rclone destination: "offsite:<bucket>[/prefix]". The offsite remote is configured by BACKUP_S3_*.
BACKUP_DEST=offsite:CHANGE_ME
BACKUP_INCLUDE_OBJECTS=true
# rclone s3 provider name: AWS, Cloudflare, Wasabi, Other (Backblaze B2 S3 API = Other)...
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
