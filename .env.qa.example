# kvm2 — QA / UAT stack (branch: qa). Copy to .env.qa on the server.
# This stack owns Caddy :80/:443 on kvm2.

SMART_ENV=qa
COMPOSE_PROJECT_NAME=smart-qa
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Note: containers ignore this and use the compose-internal `postgres:5432` host —
# this value is only for host-side tooling (SSH-tunneled psql/prisma studio, etc.).
# The api container's own runtime pool goes through the compose-internal
# `pgbouncer:6432` (transaction pooling) instead — computed from
# POSTGRES_PASSWORD below, nothing to set here. See DATABASE.md.
DATABASE_URL=postgresql://smart:CHANGE_ME@127.0.0.1:15432/smart?schema=public
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://127.0.0.1:16380
KAFKA_BROKERS=127.0.0.1:29092

JWT_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS____
CORS_ORIGINS=https://app-qa.example.com,https://tpo-qa.example.com,https://admin-qa.example.com,https://verify-qa.example.com
NEXT_PUBLIC_API_URL=https://api-qa.example.com
PUBLIC_API_URL=https://api-qa.example.com

S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=smart
S3_ACCESS_KEY=smart
S3_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=smart
MINIO_ROOT_PASSWORD=CHANGE_ME

ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_MONTHLY_CEILING_USD=500

# --- CN-T01 onboarding: GitHub repo picker + LinkedIn identity verification ---
GITHUB_API_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

API_HOST=api-qa.example.com
STUDENT_HOST=app-qa.example.com
TPO_HOST=tpo-qa.example.com
ADMIN_HOST=admin-qa.example.com
VERIFY_HOST=verify-qa.example.com

POSTGRES_PORT=15432
REDIS_PORT=16380
REDPANDA_PORT=29092
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MAILPIT_UI_PORT=18025
MAILPIT_SMTP_PORT=11025
PRISMA_STUDIO_PORT=15555
API_PORT=13000
STUDENT_PORT=13001
TPO_PORT=13002
ADMIN_PORT=13003
VERIFY_PORT=13004
PROMETHEUS_PORT=19090
GRAFANA_PORT=13100
LOKI_PORT=13101

GRAFANA_PASSWORD=CHANGE_ME
LOG_LEVEL=info
LOG_PRETTY=false
