# syntax=docker/dockerfile:1

FROM node:22.20.0-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------
# Dependencies
# ---------------------------------------------------------
FROM base AS deps

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./

# Copy package manifests only.
# This keeps the pnpm install layer cacheable when source
# files change.
COPY packages/*/package.json ./packages/
COPY apps/*/package.json ./apps/
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile

# ---------------------------------------------------------
# Build
# ---------------------------------------------------------
FROM deps AS build

COPY scripts ./scripts
COPY packages ./packages
COPY apps ./apps

ARG APP=web-student

ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ARG NEXT_PUBLIC_AUTH_URL=http://localhost:3005
ARG NEXT_PUBLIC_STUDENT_URL=http://localhost:3001
ARG NEXT_PUBLIC_TPO_URL=http://localhost:3002
ARG NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_AUTH_URL=$NEXT_PUBLIC_AUTH_URL
ENV NEXT_PUBLIC_STUDENT_URL=$NEXT_PUBLIC_STUDENT_URL
ENV NEXT_PUBLIC_TPO_URL=$NEXT_PUBLIC_TPO_URL
ENV NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL

RUN pnpm --filter @smart/${APP}... build

# Some apps don't have public/
RUN mkdir -p apps/${APP}/public

# ---------------------------------------------------------
# Runtime
# ---------------------------------------------------------
FROM node:22.20.0-bookworm-slim AS runner

ARG APP=web-student

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV APP=$APP
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

WORKDIR /app

RUN useradd --system --uid 10001 smart

COPY --from=build --chown=smart:smart \
    /app/apps/${APP}/.next/standalone ./

COPY --from=build --chown=smart:smart \
    /app/apps/${APP}/.next/static \
    ./apps/${APP}/.next/static

COPY --from=build --chown=smart:smart \
    /app/apps/${APP}/public \
    ./apps/${APP}/public

USER smart

EXPOSE 3000

CMD ["sh", "-c", "node apps/$APP/server.js"]