# syntax=docker/dockerfile:1
# Build from the monorepo root:
#   docker build -f infra/docker/Dockerfile.api -t smart-api .
FROM node:22.20.0-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY scripts ./scripts
COPY packages ./packages
COPY apps/api-core/package.json ./apps/api-core/package.json
COPY apps/api-core/prisma ./apps/api-core/prisma
COPY apps/api-core/prisma.config.ts ./apps/api-core/prisma.config.ts
COPY packages/config-typescript ./packages/config-typescript
COPY packages/config-eslint ./packages/config-eslint
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
ENV DATABASE_URL=postgresql://smart:smart@127.0.0.1:5432/smart
RUN pnpm --filter @smart/api-core... build

FROM node:22.20.0-bookworm-slim AS runner
ENV NODE_ENV=production
WORKDIR /app
RUN useradd --system --uid 10001 smart
COPY --from=build --chown=smart:smart /app/apps/api-core/dist ./apps/api-core/dist
COPY --from=build --chown=smart:smart /app/apps/api-core/package.json ./apps/api-core/package.json
COPY --from=build --chown=smart:smart /app/apps/api-core/prisma ./apps/api-core/prisma
COPY --from=build --chown=smart:smart /app/apps/api-core/prisma.config.ts ./apps/api-core/prisma.config.ts
COPY --from=build --chown=smart:smart /app/apps/api-core/src/generated ./apps/api-core/src/generated
# tsc (rootDir=src, outDir=dist) never compiles the pre-built Prisma client, so the
# compiled dist/**/*.js still `require('../../generated/prisma/...')` relative to
# dist/ — mirror the generated client there too or the container crash-loops on boot.
COPY --from=build --chown=smart:smart /app/apps/api-core/src/generated ./apps/api-core/dist/generated
COPY --from=build --chown=smart:smart /app/apps/api-core/node_modules ./apps/api-core/node_modules
COPY --from=build --chown=smart:smart /app/node_modules ./node_modules
COPY --from=build --chown=smart:smart /app/packages ./packages
COPY --from=build --chown=smart:smart /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build --chown=smart:smart /app/package.json ./package.json
USER smart
EXPOSE 3000
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
WORKDIR /app/apps/api-core
CMD ["node", "dist/main.js"]
