  companyId                  String                    @map("company_id") @db.Uuid
  company                    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  onboardingSessionId        String?                   @map("onboarding_session_id") @db.Uuid
  onboardingSession          CompanyOnboardingSession? @relation(fields: [onboardingSessionId], references: [id], onDelete: SetNull)
  registrationCountry        String                    @map("registration_country") @db.Char(2)
  jurisdictionCode           String?                   @map("jurisdiction_code")
  legalName                  String                    @map("legal_name")
  registeredAddress          Json                      @map("registered_address")
  businessRegistrationNumber String?                   @map("business_registration_number")
  taxId                      String?                   @map("tax_id")
  registrationAuthority      String?                   @map("registration_authority")
  submittedAt                DateTime?                 @map("submitted_at") @db.Timestamptz(6)
  reviewedAt                 DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  reviewedById               String?                   @map("reviewed_by_id") @db.Uuid
  reviewedBy                 User?                     @relation("CompanyVerificationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewReason               String?                   @map("review_reason")
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

