/**
 * S6-VV-76 — an async, batch-scoped candidate-matching job. `jdId` deliberately has no FK
 * relation: it may point at a `JobOpening` or a legacy `JobDescription` row (see
 * `MatchingService.resolveJob`), so it stays a plain UUID like `MatchRequest.jdId` already does.
 */
model MatchRun {
  id                 String      @id @default(uuid()) @db.Uuid
  institutionId      String      @map("institution_id") @db.Uuid
  institution        Institution @relation(fields: [institutionId], references: [id])
  jdId               String      @map("jd_id") @db.Uuid
  requestedById      String      @map("requested_by_id") @db.Uuid
  requestedBy        User        @relation("MatchRunRequestedBy", fields: [requestedById], references: [id])
  batchIds           String[]    @map("batch_ids") @db.Uuid
  minCgpa            Decimal?    @map("min_cgpa") @db.Decimal(4, 2)
  requiredSkillCodes String[]    @map("required_skill_codes")
  limit              Int
  minSkillCoverage   Decimal?    @map("min_skill_coverage") @db.Decimal(4, 3)
  /// PENDING | RUNNING | SUCCEEDED | FAILED — plain String, matching this repo's existing
  /// convention for job-status fields (e.g. ProfessionalCredential.status) rather than an enum.
  status             String      @default("PENDING")
  /// I375 — ranker version that produced this run's snapshot; frozen at creation.
  rankerVersion      String?     @map("ranker_version")
  errorMessage       String?     @map("error_message")
  eligiblePoolCount  Int?        @map("eligible_pool_count")
  suggestedCount     Int?        @map("suggested_count")
  shortlistId        String?     @map("shortlist_id") @db.Uuid
  /// Cached ShortlistDto so the polling GET can read the finished result without re-ranking.
  resultSnapshot     Json?       @map("result_snapshot")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime?   @map("completed_at") @db.Timestamptz(6)

  @@index([institutionId, jdId])
  @@map("match_runs")
}

model Application {
  id         String     @id @default(uuid()) @db.Uuid
  openingId  String     @map("opening_id") @db.Uuid
  opening    JobOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)
  studentId  String     @map("student_id") @db.Uuid
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stage      AtsStage   @default(APPLIED)
  matchScore Decimal?   @map("match_score") @db.Decimal(4, 3)
  /// APP-01 — optional note the student attached when applying (student-authored, employer-visible).
  coverNote  String?    @map("cover_note")
  /// APP-02 (Th6-417) � the company team member responsible for this candidate (a user id in the same company).
  assigneeId String?    @map("assignee_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  stageEvents ApplicationStageEvent[]
  snapshot    ApplicationSnapshot?
  notes       ApplicationNote[]
  outcome     ApplicationOutcome?

  @@unique([openingId, studentId])
  @@index([openingId, stage])
  @@index([studentId, stage])
  @@index([assigneeId])
  @@map("applications")
}

/// APP-01 (Th6-394) — immutable record of exactly what the employer could see when the student applied.
/// Written once inside the apply transaction; there is no update path. Later profile edits never change it.
model ApplicationSnapshot {
  id                String      @id @default(uuid()) @db.Uuid
  applicationId     String      @unique @map("application_id") @db.Uuid
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Employer-visible profile (the Th6-222 serializer output).
  profileJson       Json        @map("profile_json")
  /// Verified skills at apply time: [{ code, name, proficiency }].
  skillsJson        Json        @map("skills_json")
  /// Evidence the snapshot relies on: [{ type, id }]. These cannot be deleted while the application exists.
  evidenceRefs      Json        @map("evidence_refs")
  /// Fit against the job at apply time, or null when it could not be scored.
  fitJson           Json?       @map("fit_json")
  serializerVersion Int         @map("serializer_version")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("application_snapshots")
}

/// APP-02 — the hiring pipeline's statuses. Stored stages (AtsStage) stay as the university board uses
/// them; every history row also records the status it corresponds to.
enum ApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

/// Who made a status change. INSTITUTION is the university's own board.
enum StageActorType {
  EMPLOYER
  STUDENT
  SYSTEM
  INSTITUTION
}

/// APP-02 (Th6-418) — append-only record of every status change. Written only by HiringService; there is no
/// update or delete path, and the database rejects UPDATE (see the application_pipeline migration).
model ApplicationStageEvent {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     AtsStage?          @map("from_stage")
  toStage       AtsStage           @map("to_stage")
  /// APP-02 — the organisation that owns the application: the company, or the institution for university postings.
  orgId         String             @map("org_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  /// Who made the change (null for system changes).
  actorId       String?            @map("actor_id") @db.Uuid
  actorType     StageActorType     @map("actor_type")
  /// Optional note (an employer's remark or a student's withdrawal reason); internal, never in student APIs.
  note          String?
  /// Where the change came from: apply, employer_board, student_withdraw, tpo_board, shortlist, backfill...
  source        String
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([applicationId, createdAt])
  @@index([orgId, createdAt])
  @@map("application_stage_events")
}

/// APP-02 (Th6-416) � internal candidate notes. Company-only: no student API selects this table. Append-only.
model ApplicationNote {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  orgId         String      @map("org_id") @db.Uuid
  authorId      String      @map("author_id") @db.Uuid
  body          String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([applicationId, createdAt])
  @@map("application_notes")
}

