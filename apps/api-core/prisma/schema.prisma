/* -------------------------------------------------------------------------- */
/*                        Trust & Enforcement Engine                         */
/* -------------------------------------------------------------------------- */

enum TrustCaseStatus {
  OPEN
  UNDER_INVESTIGATION
  ACTION_TAKEN
  DISMISSED
}

enum TrustCaseSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EnforcementActionType {
  DISMISS
  WARN
  RESTRICT_ASSESSMENTS
  SUSPEND_VERIFICATION
  VOID_CREDENTIAL
  VOID_ATTEMPT
  BAN_ACCOUNT
}

enum EnforcementStatus {
  ACTIVE
  EXPIRED
  REVERSED
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  REJECTED
}

enum TrustReportStatus {
  RECEIVED
  INVESTIGATING
  ACTION_TAKEN
  DISMISSED_INVALID
}

enum TrustReportCategory {
  FRAUD
  IMPERSONATION
  PLAGIARISM
  SPAM
  OTHER
}

model TrustCase {
  id              String            @id @default(uuid()) @db.Uuid
  candidateId     String            @map("candidate_id") @db.Uuid
  candidate       User              @relation("UserTrustCases", fields: [candidateId], references: [id], onDelete: Cascade)
  status          TrustCaseStatus   @default(OPEN)
  severity        TrustCaseSeverity @default(MEDIUM)
  summary         String            @db.VarChar(500)
  assignedAdminId String?           @map("assigned_admin_id") @db.Uuid
  assignedAdmin   User?             @relation("UserAssignedTrustCases", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  openedAt        DateTime          @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz(6)
  resolutionNotes String?           @map("resolution_notes") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  integrityEvents    IntegrityEvent[]
  corroborationFlags CorroborationReviewFlag[]
  enforcementActions EnforcementAction[]
  trustReports       TrustReport[]
  userAccountHolds   UserAccountHold[]

  @@index([candidateId])
  @@index([status])
  @@index([severity])
  @@map("trust_cases")
}

model UserAccountHold {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustCaseId String?    @map("trust_case_id") @db.Uuid
  trustCase   TrustCase? @relation(fields: [trustCaseId], references: [id], onDelete: SetNull)
  reason      String     @db.VarChar(500)
  placedBy    String     @map("placed_by") @db.Uuid
  placedAt    DateTime   @default(now()) @map("placed_at") @db.Timestamptz(6)
  expiresAt   DateTime?  @map("expires_at") @db.Timestamptz(6)
  liftedAt    DateTime?  @map("lifted_at") @db.Timestamptz(6)
  liftedBy    String?    @map("lifted_by") @db.Uuid
  liftReason  String?    @map("lift_reason") @db.VarChar(500)

  @@index([userId, liftedAt])
  @@map("user_account_holds")
}

model EnforcementAction {
  id             String                @id @default(uuid()) @db.Uuid
  trustCaseId    String                @map("trust_case_id") @db.Uuid
  trustCase      TrustCase             @relation(fields: [trustCaseId], references: [id], onDelete: Cascade)
  candidateId    String                @map("candidate_id") @db.Uuid
  candidate      User                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actionType     EnforcementActionType @map("action_type")
  status         EnforcementStatus     @default(ACTIVE)
  reason         String                @db.Text
  appliedBy      String                @map("applied_by") @db.Uuid
  appliedAt      DateTime              @default(now()) @map("applied_at") @db.Timestamptz(6)
  expiresAt      DateTime?             @map("expires_at") @db.Timestamptz(6)
  reversedAt     DateTime?             @map("reversed_at") @db.Timestamptz(6)
  reversedBy     String?               @map("reversed_by") @db.Uuid
  reversalReason String?               @map("reversal_reason") @db.Text
  metadata       Json?

  appeals TrustAppeal[]

  @@index([candidateId, status])
  @@index([trustCaseId])
  @@map("enforcement_actions")
}

model ProfileAccessLog {
  id           String   @id @default(uuid()) @db.Uuid
  candidateId  String   @map("candidate_id") @db.Uuid
