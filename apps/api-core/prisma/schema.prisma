/**
 * WE-T03 — Manager endorsement magic-link record.
 *
 * Separate from WorkExperienceVerificationAttempt to preserve the existing
 * employer verification lifecycle.  5-day TTL; single-use (respondedAt IS NOT NULL
 * means used).  3-day (72h) reminder is scheduled at creation via BullMQ delayed job.
 */
model WorkExperienceManagerEndorsement {
  id              String    @id @default(uuid()) @db.Uuid
  experienceId    String    @map("experience_id") @db.Uuid
  experience      WorkExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  /// SHA-256 hash of the raw token.  Raw token lives only in the email; never stored.
  tokenHash       String    @unique @map("token_hash")
  managerEmail    String    @map("manager_email")
  managerName     String?   @map("manager_name")

  /// Domain used for matching (extracted from offer-letter or Organization.domain).
  resolvedDomain  String?   @map("resolved_domain")

  sentAt          DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  /// 120 hours (5 days) after sentAt.
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set when the manager opens and submits the survey. NULL = not yet responded.
  respondedAt     DateTime? @map("responded_at") @db.Timestamptz(6)
  /// Set when the 3-day reminder is dispatched.
  reminderSentAt  DateTime? @map("reminder_sent_at") @db.Timestamptz(6)

  /// PENDING | CONFIRMED | DISPUTED | EXPIRED
  status          String    @default("PENDING")

  /// true = manager confirmed the candidate worked there; false = disputed.
  confirmed       Boolean?
  /// Optional JSON array of { skillCode, rating } objects (1-5).
  skillRatings    Json?     @map("skill_ratings")
  comments        String?   @db.Text
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([experienceId])
  @@index([managerEmail])
  @@map("work_experience_manager_endorsements")
}

