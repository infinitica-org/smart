enum ExperienceDocumentType {
  OFFER_LETTER
  EXPERIENCE_LETTER
  PAYSLIP
  RELIEVING_LETTER
  FORM_16
  OTHER
}

model WorkExperience {
  id                  String                           @id @default(uuid()) @db.Uuid
  studentId           String                           @map("student_id") @db.Uuid
  student             User                             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organizationId      String?                          @map("organization_id") @db.Uuid
  organization        Organization?                    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  companyId           String?                          @map("company_id") @db.Uuid
  company             Company?                         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName         String                           @map("company_name")
  companyNameRaw      String?                          @map("company_name_raw")
  companyWebsite      String?                          @map("company_website")
  companyLinkedinUrl  String?                          @map("company_linkedin_url")
  role                String
  employmentType      EmploymentType                   @default(FULL_TIME) @map("employment_type")
  department          String?
  domain              String?
  workLocation        String?                          @map("work_location")
  startDate           DateTime                         @map("start_date") @db.Timestamptz(6)
  endDate             DateTime?                        @map("end_date") @db.Timestamptz(6)
  isCurrent           Boolean                          @default(false) @map("is_current")
  responsibilities    String?                          @db.Text
  skills              String[]                         @default([])
  projects            Json?
  candidateLinkedin   String?                          @map("candidate_linkedin")
  verifierName        String?                          @map("verifier_name")
  verifierEmail       String?                          @map("verifier_email")
  verifierDesignation String?                          @map("verifier_designation")
  verifierPhone       String?                          @map("verifier_phone")
  status              WorkExperienceVerificationStatus @default(SUBMITTED)
  rejectionReason     String?                          @map("rejection_reason")
  createdAt           DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // WE-T03: verification state machine fields
  /// true when at least one attached document has validationStatus = 'VALIDATED'
  docOk               Boolean                          @default(false) @map("doc_ok")
  /// true when a manager has CONFIRMED the endorsement via magic link
  completedConfirmed  Boolean                          @default(false) @map("completed_confirmed")
  /// doc_ok && completed_confirmed — computed on each state transition, never auto-set on expiry
  overallVerified     Boolean                          @default(false) @map("overall_verified")

  documents            WorkExperienceDocument[]
  verificationAttempts WorkExperienceVerificationAttempt[]
  managerEndorsements  WorkExperienceManagerEndorsement[]

  @@index([studentId, status])
  @@index([companyId])
  @@index([organizationId])
  @@map("work_experiences")
}

