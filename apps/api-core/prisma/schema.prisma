model Organization {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String
  domain             String?                  @unique
  orgType            OrganizationType         @default(EMPLOYER) @map("org_type")
  verificationStatus TenantVerificationStatus @default(PENDING) @map("verification_status")
  verificationReason String?                  @map("verification_reason")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// S6-VV-105 (#168) — who created / last changed this record; null for rows that predate tracking.
  createdById        String?                  @map("created_by_id") @db.Uuid
  createdBy          User?                    @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?                  @map("updated_by_id") @db.Uuid
  updatedBy          User?                    @relation("OrganizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  companies       Company[]
  institutions    Institution[]
  workExperiences WorkExperience[]

  @@map("organizations")
}

model Company {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String?                  @map("organization_id") @db.Uuid
  organization       Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name               String
  domain             String                   @unique
  gstin              String?
  website            String?
  linkedinUrl        String?                  @map("linkedin_url")
  sector             String?
  mode               CompanyMode?
  taxonomyDomain     String?                  @map("taxonomy_domain")
  sizeBand           String?                  @map("size_band")
  location           String?
  verificationStatus TenantVerificationStatus @default(PENDING) @map("verification_status")
  verificationReason String?                  @map("verification_reason")
  deactivatedAt      DateTime?                @map("deactivated_at") @db.Timestamptz(6)
  heldAt             DateTime?                @map("held_at") @db.Timestamptz(6)
  planId             String                   @map("plan_id") @db.Uuid
  plan               SubscriptionPlan         @relation(fields: [planId], references: [id])
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  /// S6-VV-105 (#168) — who created / last changed this record; null for rows that predate tracking.
  createdById        String?                  @map("created_by_id") @db.Uuid
  createdBy          User?                    @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?                  @map("updated_by_id") @db.Uuid
  updatedBy          User?                    @relation("CompanyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  users                 User[]
  jobOpenings           JobOpening[]
  featureFlagOverrides  FeatureFlagOverride[]
  workExperiences       WorkExperience[]
  onboardingSessions    CompanyOnboardingSession[]
  verifications         CompanyVerification[]
  verificationDocuments CompanyVerificationDocument[]
  profile               CompanyProfile?
  reviews               CompanyReview[]

  @@index([organizationId])
  @@map("companies")
}

/// EMP-02 — editable public profile of a company. `version` is the optimistic lock (If-Match).
/// Only companies whose verificationStatus is APPROVED are publicly readable.
model CompanyProfile {
  id                  String                @id @default(uuid()) @db.Uuid
  companyId           String                @unique @map("company_id") @db.Uuid
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug                String                @unique
  displayName         String                @map("display_name")
  logoFileId          String?               @map("logo_file_id")
  website             String?
  about               String?
  benefits            String[]              @default([])
  socialLinks         Json                  @default("{}") @map("social_links")
  industry            String?
  employeeCount       CompanyEmployeeCount? @map("employee_count")
  headquarters        String?
  additionalLocations String[]              @default([]) @map("additional_locations")
  version             Int                   @default(1)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("company_profiles")
}

/// JOB-02 (Th6-384) — a student's bookmark. Composite PK makes save idempotent.
model SavedJob {
  studentId String     @map("student_id") @db.Uuid
  student   User       @relation("SavedJobStudent", fields: [studentId], references: [id], onDelete: Cascade)
  jobId     String     @map("job_id") @db.Uuid
  job       JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt   DateTime   @default(now()) @map("saved_at") @db.Timestamptz(6)

  @@id([studentId, jobId])
  @@index([jobId])
  @@map("saved_jobs")
}

/// JOB-02 (Th6-385) — a job the student does not want to see again (list and dashboard top matches).
model HiddenJob {
  studentId String     @map("student_id") @db.Uuid
  student   User       @relation("HiddenJobStudent", fields: [studentId], references: [id], onDelete: Cascade)
  jobId     String     @map("job_id") @db.Uuid
  job       JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason    String?
  hiddenAt  DateTime   @default(now()) @map("hidden_at") @db.Timestamptz(6)

  @@id([studentId, jobId])
  @@index([jobId])
  @@map("hidden_jobs")
}

enum ReportTargetType {
  JOB
  MESSAGE
}

enum ReportReason {
  SCAM
  DISCRIMINATORY
  MISLEADING
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

/// JOB-02 (Th6-386) — a user report about content. `targetType` leaves room for other targets
/// (Th6-482). One report per reporter per target; a repeat returns the existing one.
model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  reporter   User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId, status])
  @@map("reports")
}

/// Th6-355 — a review of a company left by a student/intern. Submission is a separate (student-side) ticket;
/// this ticket only lets the company respond, and only where `responsePermitted` is true.
model CompanyReview {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// The reviewing student; one review per student per company. Never exposed to the company.
  authorId          String              @map("author_id") @db.Uuid
  /// Display label only (e.g. "Applicant"); the reviewer's identity is not exposed to the company.
  authorLabel       String              @map("author_label")
  rating            Int
  body              String              @db.Text
  status            CompanyReviewStatus @default(PUBLISHED)
  responsePermitted Boolean             @default(false) @map("response_permitted")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  response          ReviewResponse?

  @@unique([companyId, authorId])
  @@index([companyId, createdAt])
  @@map("company_reviews")
}

enum CompanyReviewStatus {
  PUBLISHED
  HIDDEN
}

/// Th6-355 — the company's single, editable reply to a review (max 1000 chars, enforced in the DTO).
model ReviewResponse {
  id        String        @id @default(uuid()) @db.Uuid
  reviewId  String        @unique @map("review_id") @db.Uuid
  review    CompanyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  companyId String        @map("company_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  body      String        @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId])
  @@map("review_responses")
}

/// EMP-02 — Idempotency-Key ledger for employer mutations: a retry with the same key replays the
/// stored response instead of repeating the write.
model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  scope        String
  key          String
  requestHash  String   @map("request_hash")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, scope, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

/// Public company self-onboarding session. Raw session tokens are never stored — only sessionTokenHash.
/// Company row is linked once the tenant exists (typically before submit with verificationStatus=PENDING).
model CompanyOnboardingSession {
  id                         String                  @id @default(uuid()) @db.Uuid
  companyId                  String?                 @map("company_id") @db.Uuid
  company                    Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  onboardingStatus           CompanyOnboardingStatus @default(DRAFT) @map("onboarding_status")
  sessionTokenHash           String                  @unique @map("session_token_hash")
  expiresAt                  DateTime                @map("expires_at") @db.Timestamptz(6)
  /// Normalized representative work email for lookup/dedup (application layer lowercases).
  representativeEmail        String                  @map("representative_email")
  /// Contract-shaped representative fields (CompanyRepresentativeSchema snapshot).
  representativeSnapshot     Json?                   @map("representative_snapshot")
  /// In-progress CompanySignupProfileSchema snapshot until submit.
  profileDraft               Json?                   @map("profile_draft")
  /// Set after corporate email verification when a User row is provisioned (Phase 6).
  userId                     String?                 @map("user_id") @db.Uuid
  user                       User?                   @relation("CompanyOnboardingUser", fields: [userId], references: [id], onDelete: SetNull)
  emailVerifiedAt            DateTime?               @map("email_verified_at") @db.Timestamptz(6)
  emailVerificationCodeHash  String?                 @map("email_verification_code_hash")
  emailVerificationExpiresAt DateTime?               @map("email_verification_expires_at") @db.Timestamptz(6)
  lastEmailSentAt            DateTime?               @map("last_email_sent_at") @db.Timestamptz(6)
  submittedAt                DateTime?               @map("submitted_at") @db.Timestamptz(6)
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  verifications CompanyVerification[]

  @@index([companyId])
  @@index([onboardingStatus])
  @@index([expiresAt])
  @@index([representativeEmail])
  @@map("company_onboarding_sessions")
}

/// One KYC submission/version for a company tenant. Historical rows are retained for resubmission audit.
model CompanyVerification {
