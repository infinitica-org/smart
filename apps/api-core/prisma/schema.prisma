/// Verification document metadata — binary content lives in object storage (storageKey).
model CompanyVerificationDocument {
  id                    String                                  @id @default(uuid()) @db.Uuid
  companyVerificationId String                                  @map("company_verification_id") @db.Uuid
  companyVerification   CompanyVerification                     @relation(fields: [companyVerificationId], references: [id], onDelete: Cascade)
  companyId             String                                  @map("company_id") @db.Uuid
  company               Company                                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentType          CompanyVerificationDocumentType         @map("document_type")
  fileName              String                                  @map("file_name")
  mimeType              String                                  @map("mime_type")
  fileSizeBytes         Int                                     @map("file_size_bytes")
  storageKey            String                                  @map("storage_key")
  uploadedBy            CompanyVerificationDocumentUploadedBy   @map("uploaded_by")
  uploadedAt            DateTime                                @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  reviewStatus          CompanyVerificationDocumentReviewStatus @default(PENDING) @map("review_status")
  reviewReason          String?                                 @map("review_reason")
  reviewedAt            DateTime?                               @map("reviewed_at") @db.Timestamptz(6)
  reviewedById          String?                                 @map("reviewed_by_id") @db.Uuid
  reviewedBy            User?                                   @relation("CompanyVerificationDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt             DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyVerificationId])
