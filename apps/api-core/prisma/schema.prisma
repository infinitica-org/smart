  verificationAttempts CandidateCertificateVerificationAttempt[]

  @@index([candidateId, status])
  @@map("candidate_certificates")
}

model CandidateCertificateVerificationAttempt {
  id                     String               @id @default(uuid()) @db.Uuid
  candidateCertificateId String               @map("candidate_certificate_id") @db.Uuid
  candidateCertificate   CandidateCertificate @relation(fields: [candidateCertificateId], references: [id], onDelete: Cascade)
  technicalFailure       Boolean              @default(false) @map("technical_failure")
  passed                 Boolean?
  explanation            String               @db.Text
  marksEarned            Float?               @map("marks_earned")
  marksTotal             Float?               @map("marks_total")
  scorePercent           Float?               @map("score_percent")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([candidateCertificateId, createdAt])
  @@map("candidate_certificate_verification_attempts")
}

model CandidateCertificateSkill {
  id                      String                 @id @default(uuid()) @db.Uuid
  candidateCertificateId  String                 @map("candidate_certificate_id") @db.Uuid
  candidateCertificate    CandidateCertificate   @relation(fields: [candidateCertificateId], references: [id], onDelete: Cascade)
  skillCode               String                 @map("skill_code")
  selfAssessedProficiency CertificateProficiency @map("self_assessed_proficiency")
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([candidateCertificateId, skillCode])
  @@map("candidate_certificate_skills")
}

model CertificateVerificationEvent {
  id                     String                     @id @default(uuid()) @db.Uuid
  candidateCertificateId String                     @map("candidate_certificate_id") @db.Uuid
  candidateCertificate   CandidateCertificate       @relation(fields: [candidateCertificateId], references: [id], onDelete: Cascade)
  status                 CandidateCertificateStatus
  message                String
  metadata               Json?
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([candidateCertificateId, createdAt])
  @@map("certificate_verification_events")
}

model CertificateEndorsement {
  id                     String                       @id @default(uuid()) @db.Uuid
  candidateCertificateId String                       @map("candidate_certificate_id") @db.Uuid
  candidateCertificate   CandidateCertificate         @relation(fields: [candidateCertificateId], references: [id], onDelete: Cascade)
  endorserName           String                       @map("endorser_name")
  endorserEmail          String                       @map("endorser_email")
  endorserTitle          String?                      @map("endorser_title")
  tokenHash              String                       @unique @map("token_hash")
  status                 CertificateEndorsementStatus @default(PENDING)
  comments               String?                      @db.Text
  respondedAt            DateTime?                    @map("responded_at") @db.Timestamptz(6)
  expiresAt              DateTime                     @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([candidateCertificateId])
  @@map("certificate_endorsements")
}

model CandidateEducation {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institutionName String   @map("institution_name")
  degree          String?
  fieldOfStudy    String?  @map("field_of_study")
  startDate       String?  @map("start_date")
  endDate         String?  @map("end_date")
  current         Boolean  @default(false)
  grade           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([studentId])
  @@map("candidate_educations")
}

model CandidateLanguage {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  language    String
  proficiency String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([studentId])
  @@map("candidate_languages")
}

