// SMART relational schema — maps ARCHITECTURE.md §5 plus identity, placement,
// calibration and audit tables required by @smart/contracts.
// Owner: Vishal V (schema + migrations). Domain columns are owned with the
// module that writes them; changing an enum here is a contracts PR.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  PLACEMENT_STAFF
  STUDENT
  B2B_PARTNER
  COMPANY
  SUPPORT_AGENT
  SUPPORT_LEAD
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  GITHUB
  SAML
  OIDC
}

enum TrackCategory {
  TECH
  MBA
}

enum TrackLaunchStatus {
  DRAFT
  AVAILABLE_NEW
  VALIDATED_LEAD
}

enum CalibrationStatus {
  NOT_CALIBRATED
  PROVISIONAL
  PANEL_CALIBRATED
  RELIABILITY_VERIFIED
}

enum DomainCode {
  A
  B
  C
  D
  E
}

enum LevelFormat {
  MCQ
  SANDBOX
  AUDIO_BARS
  DEFENSE
  CAPSTONE
}

enum ItemType {
  MCQ_SINGLE
  MCQ_MULTI
  NUMERIC_ENTRY
  SHORT_ANSWER
  CODE_TASK
  SQL_TASK
  SCENARIO_RESPONSE
  SPOKEN_RESPONSE
  DEFENSE_PROMPT
  ARTIFACT_UPLOAD
}

enum DifficultyTag {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EVALUATING
  EVALUATED
  ABANDONED
  VOIDED
}

enum IntegrityFlag {
  CLEAN
  FLAGGED_TIMING
  FLAGGED_PROCTOR
  FLAGGED_SIMILARITY
  FLAGGED_AUDIO
  UNDER_REVIEW
  CLEARED
  ESCALATED
}

enum Evaluator {
  AUTO_MCQ
  AUTO_NUMERIC
  SANDBOX_CHECK
  CHECKLIST
  LLM_BARS
  HUMAN_RATER
  HYBRID
}

enum Tier {
  GOLD
  SILVER
  BRONZE
  BELOW_BRONZE
}

enum CertifiableTier {
  GOLD
  SILVER
  BRONZE
}

enum CertificateStatus {
  PENDING_ISSUE
  BLOCKED_INTEGRITY
  ISSUED
  SUPERSEDED
  REVOKED
}

enum JdParseStatus {
  PENDING
  PARSED
  FAILED
  MANUALLY_CORRECTED
}

enum PlacementOutcome {
  NOT_SHORTLISTED
  SHORTLISTED
  INTERVIEWED
  OFFERED
  ACCEPTED
  DECLINED
}

enum AiProvider {
  ANTHROPIC
  GOOGLE
  OPENROUTER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TenantVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// EMP-02 — what a COMPANY user may do inside their company tenant.
enum CompanyMemberRole {
  OWNER
  RECRUITER
}

/// EMP-02 — employee-count bands on the public company profile.
enum CompanyEmployeeCount {
  E_1_10
  E_11_50
  E_51_200
  E_201_500
  E_501_1000
  E_1000_PLUS
}

enum OrganizationType {
  UNIVERSITY
  EMPLOYER
}

enum CompanyMode {
  SERVICE
  PRODUCT
}

/// CO self-onboarding applicant progress — mirrors @smart/contracts CompanyOnboardingStatus.
enum CompanyOnboardingStatus {
  DRAFT
  EMAIL_VERIFICATION_PENDING
  EMAIL_VERIFIED
  SUBMITTED
  PENDING_REVIEW
  RESUBMISSION_ALLOWED
  ACCOUNT_ACTIVE
  WITHDRAWN
  EXPIRED
}

enum CompanyVerificationDocumentType {
  BUSINESS_REGISTRATION
  CERTIFICATE_OF_INCORPORATION
  TAX_DOCUMENT
  GOVERNMENT_ID
  AUTHORITY_PROOF
  COMPANY_LOGO
  OTHER
}

enum CompanyVerificationDocumentReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CompanyVerificationDocumentUploadedBy {
  REPRESENTATIVE
  SUPER_ADMIN
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  PROFICIENT
  ADVANCED
  PROFESSIONAL
}

enum SkillClaimStatus {
  DECLARED
  VERIFIED
  BEGINNER_REATTEMPT
  LOCKED
}

/// CN-T01 — where a SkillClaim's initial declaration came from. GITHUB_DERIVED
/// claims are auto-declared (BEGINNER only) from onboarding GitHub language
/// analysis; they still go through the same verification state machine as a
/// manually declared claim.
enum SkillClaimSource {
  MANUAL
  GITHUB_DERIVED
}

enum JobOpeningStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AtsStage {
  APPLIED
  SHORTLISTED
  AI_VERIFIED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum NotificationKind {
  OPPORTUNITY
  STAGE_CHANGE
  VERIFICATION_RESULT
  INVITATION
  TRUST_ENFORCEMENT
  APPLICATION
  MESSAGE
}

enum ProjectStatus {
  SUBMITTED
  VERIFIED
  UNDER_REVIEW
  REJECTED
}

enum PlanCode {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

model Institution {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String
  domain             String                   @unique
  taxonomyDomain     String?                  @map("taxonomy_domain")
  verificationStatus TenantVerificationStatus @default(APPROVED) @map("verification_status")
  verificationReason String?                  @map("verification_reason")
  deactivatedAt      DateTime?                @map("deactivated_at") @db.Timestamptz(6)
  heldAt             DateTime?                @map("held_at") @db.Timestamptz(6)
  planId             String                   @map("plan_id") @db.Uuid
  plan               SubscriptionPlan         @relation(fields: [planId], references: [id])
  organizationId     String?                  @map("organization_id") @db.Uuid
  organization       Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  /// S6-VV-105 (#168) — who created / last changed this record; null for rows that predate tracking.
  createdById        String?                  @map("created_by_id") @db.Uuid
  createdBy          User?                    @relation("InstitutionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?                  @map("updated_by_id") @db.Uuid
  updatedBy          User?                    @relation("InstitutionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  users                User[]
  batches              Batch[]
  invitations          Invitation[]
  jobDescriptions      JobDescription[]
  jobOpenings          JobOpening[]
  placementEmployers   PlacementEmployer[]
  matchRuns            MatchRun[]
  webhooks             WebhookEndpoint[]
  featureFlagOverrides FeatureFlagOverride[]

  @@index([organizationId])
  @@map("institutions")
}

model Batch {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  createdById   String      @map("created_by_id") @db.Uuid
  createdBy     User        @relation("BatchCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  members     User[]       @relation("BatchMembers")
  invitations Invitation[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("batches")
}

model Invitation {
  id            String             @id @default(uuid()) @db.Uuid
  email         String
  fullName      String             @map("full_name")
  role          UserRole
  /// Null for platform-admin invites (SUPER_ADMIN), which have no owning tenant.
  institutionId String?            @map("institution_id") @db.Uuid
  institution   Institution?       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  batchId       String?            @map("batch_id") @db.Uuid
  batch         Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  /// EMP-02 — set for employer-side invitations (recruiters); null for university invites.
  companyId     String?            @map("company_id") @db.Uuid
  companyRole   CompanyMemberRole? @map("company_role")
  groupLabel    String?            @map("group_label")
  userId        String             @map("user_id") @db.Uuid
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String             @unique @map("token_hash")
  status        InvitationStatus   @default(PENDING)
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(6)
  acceptedAt    DateTime?          @map("accepted_at") @db.Timestamptz(6)
  invitedById   String             @map("invited_by_id") @db.Uuid
  invitedBy     User               @relation("InvitationInvitedBy", fields: [invitedById], references: [id])
  lastSentAt    DateTime?          @map("last_sent_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([institutionId, status])
  @@index([companyId, status])
  @@index([batchId])
  @@index([userId])
  @@map("invitations")
}

enum UniversityContactRequestStatus {
  PENDING
}

/// STU-01 — a student's ask for SMART to contact a university that isn't yet
/// a partner. No outbound notification is wired for this ticket; this is
/// purely an internal, auditable record for ops to review later.
model UniversityContactRequest {
  id                       String                         @id @default(uuid()) @db.Uuid
  studentUserId            String                         @map("student_user_id") @db.Uuid
  student                  User                           @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  universityName           String                         @map("university_name")
  /// Trimmed + lowercased `universityName`, used only for de-dup matching.
  normalizedUniversityName String                         @map("normalized_university_name")
  status                   UniversityContactRequestStatus @default(PENDING)
  createdAt                DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([studentUserId, normalizedUniversityName])
  @@index([studentUserId])
  @@map("university_contact_requests")
}

model User {
  convMemberships        ConversationParticipant[] @relation("ConversationParticipantUser")
  sentMessages           Message[]                 @relation("MessageSender")
  blocksMade             Block[]                   @relation("BlockBlocker")
  blocksReceived         Block[]                   @relation("BlockBlocked")
  id                     String                    @id @default(uuid()) @db.Uuid
  email                  String                    @unique
  fullName               String                    @map("full_name")
  passwordHash           String?                   @map("password_hash")
  /// S6-VV-92 — consecutive wrong-password count since the last successful login or lockout; never serialized.
  failedLoginAttempts    Int                       @default(0) @map("failed_login_attempts")
  /// S6-VV-92 — set once failedLoginAttempts hits the threshold; login is refused until this passes.
  loginLockedUntil       DateTime?                 @map("login_locked_until") @db.Timestamptz(6)
  role                   UserRole
  provider               AuthProvider              @default(PASSWORD)
  emailVerified          Boolean                   @default(false) @map("email_verified")
  institutionId          String?                   @map("institution_id") @db.Uuid
  institution            Institution?              @relation(fields: [institutionId], references: [id])
  batchId                String?                   @map("batch_id") @db.Uuid
  batch                  Batch?                    @relation("BatchMembers", fields: [batchId], references: [id], onDelete: SetNull)
  groupLabel             String?                   @map("group_label")
  primaryTrackId         String?                   @map("primary_track_id") @db.Uuid
  primaryTrack           Track?                    @relation("UserPrimaryTrack", fields: [primaryTrackId], references: [id])
  secondaryTrackId       String?                   @map("secondary_track_id") @db.Uuid
  secondaryTrack         Track?                    @relation("UserSecondaryTrack", fields: [secondaryTrackId], references: [id])
  heldAt                 DateTime?                 @map("held_at") @db.Timestamptz(6)
  heldReason             String?                   @map("held_reason")
  /// CN-T01 — mandatory candidate onboarding gate (server-side; not localStorage).
  onboardingCompleted    Boolean                   @default(false) @map("onboarding_completed")
  /// Structured onboarding profile + consent snapshot (JSON).
  onboardingDetails      Json?                     @map("onboarding_details")
  /// Object storage key for the candidate profile photo (signed URL served at read time).
  profilePhotoObjectKey  String?                   @map("profile_photo_object_key")
  dpdpConsentAt          DateTime?                 @map("dpdp_consent_at") @db.Timestamptz(6)
  /// Persistent, non-expiring public-profile share link (lazily minted on first request).
  publicProfileSlug      String?                   @unique @map("public_profile_slug")
  /// S6-VV-75 — CGPA on a 0-10 scale, collected during onboarding; denormalized onto User (not
  /// CandidateEducation) because matching needs a single indexable value per student.
  cgpa                   Decimal?                  @map("cgpa") @db.Decimal(4, 2)
  /// S6-VV-75 — 10th/SSC exam percentage (0-100).
  sscPercentage          Decimal?                  @map("ssc_percentage") @db.Decimal(5, 2)
  /// S6-VV-75 — 12th/HSC exam percentage (0-100).
  hscPercentage          Decimal?                  @map("hsc_percentage") @db.Decimal(5, 2)
  /// Active academic backlog (placement eligibility).
  hasActiveBacklog       Boolean?                  @map("has_active_backlog")
  /// Study program (e.g. "B.Tech CSE") + graduation year, collected during onboarding.
  /// graduationYear is denormalized onto User (like cgpa/sscPercentage above) so placement
  /// pool filtering (packages/contracts/src/dto/placement.dto.ts filters.graduationYear)
  /// can query it directly. studyProgram stays JSON-only in onboardingDetails.
  graduationYear         Int?                      @map("graduation_year")
  /// CN-T09 — display-case username; uniqueness is enforced on `usernameNormalized`, not this column.
  username               String?                   @map("username")
  /// CN-T09 — lowercased/trimmed form used for case-insensitive uniqueness and lookups.
  usernameNormalized     String?                   @unique @map("username_normalized")
  /// CN-T09 — reservation claims the name; activation (flipped on first visibility opt-in) is a separate step.
  usernameStatus         UsernameStatus?           @map("username_status")
  usernameReservedAt     DateTime?                 @map("username_reserved_at") @db.Timestamptz(6)
  usernameActivatedAt    DateTime?                 @map("username_activated_at") @db.Timestamptz(6)
  /// CN-T09 — internal-only rate-limit state for reservation attempts; never serialized in any API response.
  usernameFailedAttempts Int                       @default(0) @map("username_failed_attempts")
  usernameCooldownUntil  DateTime?                 @map("username_cooldown_until") @db.Timestamptz(6)
  /// CN-T09 — global on/off switch for the public profile page (`publicProfileSlug` already existed; this gates whether it resolves).
  profileVisible         Boolean                   @default(false) @map("profile_visible")
  /// CN-T09 — opt-in only; default keeps the public page verified-items-only.
  hiddenSections         String[]                  @default([]) @map("hidden_sections")
  showInProgressItems    Boolean                   @default(false) @map("show_in_progress_items")
  /// STU-02 — student-controlled switch for employer-initiated messages.
  allowEmployerMessages  Boolean                   @default(true) @map("allow_employer_messages")
  /// STU-02 — self-service deactivation; blocks sign-in and hides the profile until cleared.
  deactivatedAt          DateTime?                 @map("deactivated_at") @db.Timestamptz(6)
  /// STU-03 — student opt-in: show the count of employer profile views on the dashboard.
  showEmployerViewCount  Boolean                   @default(false) @map("show_employer_view_count")
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  refreshTokens                        RefreshToken[]
  emailVerificationTokens              EmailVerificationToken[]
  passwordResetTokens                  PasswordResetToken[]
  attempts                             Attempt[]
  certificates                         Certificate[]
  placements                           PlacementRecord[]
  batchesCreated                       Batch[]                       @relation("BatchCreatedBy")
  invitationsReceived                  Invitation[]
  invitationsSent                      Invitation[]                  @relation("InvitationInvitedBy")
  companyId                            String?                       @map("company_id") @db.Uuid
  company                              Company?                      @relation(fields: [companyId], references: [id])
  /// EMP-02 — role inside the company tenant; null for non-company users.
  companyRole                          CompanyMemberRole?            @map("company_role")
  savedJobs                            SavedJob[]                    @relation("SavedJobStudent")
  hiddenJobs                           HiddenJob[]                   @relation("HiddenJobStudent")
  reportsMade                          Report[]                      @relation("ReportReporter")
  skillClaims                          SkillClaim[]
  projects                             Project[]
  applications                         Application[]
  cognitiveProfile                     CognitiveProfile?
  communicationProfile                 CommunicationProfile?
  auditLogs                            AuditLog[]
  jobOpeningsCreated                   JobOpening[]                  @relation("JobOpeningCreatedBy")
  matchRunsRequested                   MatchRun[]                    @relation("MatchRunRequestedBy")
  notifications                        Notification[]
  workExperiences                      WorkExperience[]
  candidateCertificates                CandidateCertificate[]
  candidateEducations                  CandidateEducation[]
  candidateLanguages                   CandidateLanguage[]
  evidenceRecords                      EvidenceRecord[]
  professionalCredentials              ProfessionalCredential[]
  passiveSignalEvidence                PassiveSignalEvidence[]
  corroborationSnapshots               CorroborationSnapshot[]
  corroborationReviewFlags             CorroborationReviewFlag[]
  evidenceProfile                      CandidateEvidenceProfile?
  studentCapabilities                  StudentCapability[]
  universityContactRequests            UniversityContactRequest[]
  dataSubjectRequests                  DataSubjectRequest[]
  profileViewsReceived                 ProfileView[]                 @relation("ProfileViewStudent")
  profileViewsMade                     ProfileView[]                 @relation("ProfileViewViewer")
  companyOnboardingSessions            CompanyOnboardingSession[]    @relation("CompanyOnboardingUser")
  companyVerificationsReviewed         CompanyVerification[]         @relation("CompanyVerificationReviewedBy")
  companyVerificationDocumentsReviewed CompanyVerificationDocument[] @relation("CompanyVerificationDocumentReviewedBy")
  organizationsCreated                 Organization[]                @relation("OrganizationCreatedBy")
  organizationsUpdated                 Organization[]                @relation("OrganizationUpdatedBy")
  institutionsCreated                  Institution[]                 @relation("InstitutionCreatedBy")
  institutionsUpdated                  Institution[]                 @relation("InstitutionUpdatedBy")
  companiesCreated                     Company[]                     @relation("CompanyCreatedBy")
  companiesUpdated                     Company[]                     @relation("CompanyUpdatedBy")
  evidenceSkillDisputes                EvidenceSkillDispute[]        @relation("StudentEvidenceSkillDisputes")
  evidenceSkillDisputesReviewed        EvidenceSkillDispute[]        @relation("DisputeReviewer")
  matchFeedbacksGiven                  MatchFeedback[]               @relation("MatchFeedbackUser")
  matchFeedbacksReceived               MatchFeedback[]               @relation("MatchFeedbackStudent")
  savedCandidatesCreated               SavedCandidate[]              @relation("SavedCandidatesCreated")
  savedAsCandidate                     SavedCandidate[]              @relation("SavedCandidatesReceived")




  trustCasesAsCandidate        TrustCase[]               @relation("UserTrustCases")
  trustCasesAsAdmin            TrustCase[]               @relation("UserAssignedTrustCases")
  accountHolds                 UserAccountHold[]
  enforcementActions           EnforcementAction[]
  trustAppeals                 TrustAppeal[]
  profileAccessLogsAsCandidate ProfileAccessLog[]        @relation("UserProfileAccessCandidate")
  profileAccessLogsAsViewer    ProfileAccessLog[]        @relation("UserProfileAccessViewer")
  trustReportsTargeted         TrustReport[]             @relation("UserReportsTargeted")
  trustReportsCreated          TrustReport[]             @relation("UserReportsCreated")

  careerDomainId String? @map("career_domain_id")
  targetRoleId   String? @map("target_role_id")

  @@index([institutionId])
  @@index([batchId])
  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  keyPrefix String    @map("key_prefix")
  keyHash   String    @unique @map("key_hash")
  role      UserRole  @default(B2B_PARTNER)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("api_keys")
}

model Track {
  id                  String            @id @default(uuid()) @db.Uuid
  code                String            @unique
  name                String
  category            TrackCategory
  launchStatus        TrackLaunchStatus @default(DRAFT) @map("launch_status")
  calibrationStatus   CalibrationStatus @default(NOT_CALIBRATED) @map("calibration_status")
  foundationWeight    Decimal           @default(0) @map("foundation_weight") @db.Decimal(4, 2)
  capstoneBrief       String            @map("capstone_brief")
  communicationDomain DomainCode        @map("communication_domain")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  competencies      Competency[]
  levels            Level[]
  primaryUsers      User[]             @relation("UserPrimaryTrack")
  secondaryUsers    User[]             @relation("UserSecondaryTrack")
  certificates      Certificate[]
  jobDescriptions   JobDescription[]
  placements        PlacementRecord[]
  calibrationPanels CalibrationPanel[]

  @@map("tracks")
}

model Competency {
  id               String                       @id @default(uuid()) @db.Uuid
  trackId          String                       @map("track_id") @db.Uuid
  track            Track                        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  domainCode       DomainCode                   @map("domain_code")
  name             String
  subDomain        String                       @map("sub_domain")
  realWorldWeight  Decimal                      @map("real_world_weight") @db.Decimal(4, 2)
  assessedAtLevels Int[]                        @map("assessed_at_levels")
  /// Nullable stub for S1-RM-03 (Ramansh owns writes). Schema steward: Vishal V.
  embedding        Unsupported("vector(1536)")?
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  items Item[]

  @@index([trackId, domainCode])
  @@map("competencies")
}

model Level {
  id              String      @id @default(uuid()) @db.Uuid
  trackId         String      @map("track_id") @db.Uuid
  track           Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  levelNumber     Int         @map("level_number")
  name            String
  format          LevelFormat
  durationMinutes Int         @map("duration_minutes")
  itemCount       Int         @default(0) @map("item_count")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  items     Item[]
  attempts  Attempt[]
  results   LevelResult[]
  cutScores CutScore[]
  panels    CalibrationPanel[]

  @@unique([trackId, levelNumber])
  @@map("levels")
}

model Item {
  id            String        @id @default(uuid()) @db.Uuid
  levelId       String        @map("level_id") @db.Uuid
  level         Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  competencyId  String        @map("competency_id") @db.Uuid
  competency    Competency    @relation(fields: [competencyId], references: [id])
  itemType      ItemType      @map("item_type")
  stem          String
  modelAnswer   Json?         @map("model_answer")
  difficultyTag DifficultyTag @map("difficulty_tag")
  active        Boolean       @default(true)
  formCode      String        @default("A") @map("form_code")
  exposureCount Int           @default(0) @map("exposure_count")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  options   ItemOption[]
  responses Response[]

  @@index([levelId, active, formCode])
  @@index([competencyId])
  @@map("items")
}

model ItemOption {
  id        String  @id @default(uuid()) @db.Uuid
  itemId    String  @map("item_id") @db.Uuid
