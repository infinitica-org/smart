  user           User                        @relation("ConversationParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationParticipantRole
  orgId          String?                     @map("org_id") @db.Uuid
  lastReadAt     DateTime?                   @map("last_read_at") @db.Timestamptz(6)
  mutedAt        DateTime?                   @map("muted_at") @db.Timestamptz(6)
  hiddenAt       DateTime?                   @map("hidden_at") @db.Timestamptz(6)
  leftAt         DateTime?                   @map("left_at") @db.Timestamptz(6)
  joinedAt       DateTime                    @default(now()) @map("joined_at") @db.Timestamptz(6)

  @@unique([conversationId, userId])
  @@index([userId, hiddenAt])
  @@map("conversation_participants")
}

