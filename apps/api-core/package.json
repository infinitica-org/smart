{
  "name": "@smart/api-core",
  "version": "0.1.0",
  "private": true,
  "description": "SMART NestJS API: platform core plus owned domain modules. Owners: Vishal V (platform), plus module owners in TEAM.md.",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run src",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo src/generated",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:load-test": "tsx prisma/seed-load-test.ts",
    "match:e2e": "tsx scripts/run-match-engine-e2e.ts",
    "db:seed:project-defense-demo": "tsx prisma/seed-project-defense-demo.ts",
    "db:reset:project-defense-proctoring": "tsx prisma/reset-project-defense-proctoring.ts",
    "db:reset:project-defense-interview": "tsx prisma/reset-project-defense-interview.ts",
    "prisma": "prisma"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@aws-sdk/client-s3": "3.1126.0",
    "@aws-sdk/s3-request-presigner": "3.1126.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "^10.1.3",
    "@google/genai": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "catalog:",
    "@smart/contracts": "workspace:*",
    "@smart/observability": "workspace:*",
    "@smart/prompts": "workspace:*",
    "@smart/scoring-engine": "workspace:*",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "bullmq": "6.2.0",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "exceljs": "4.4.0",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "kafkajs": "catalog:",
    "nestjs-pino": "catalog:",
    "nodemailer": "7.0.6",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@smart/eslint-config": "workspace:*",
    "@smart/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "7.0.1",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "rimraf": "6.0.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
