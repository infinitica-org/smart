# kvm4 — production (branch: main). Copy to .env.prod on the server.
# Only @brittytino deploys here.

SMART_ENV=prod
COMPOSE_PROJECT_NAME=smart-prod
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Note: containers ignore this and use the compose-internal `postgres:5432` host —
# this value is only for host-side tooling (SSH-tunneled psql/prisma studio, etc.).
# The api container's own runtime pool goes through the compose-internal
# `pgbouncer:6432` (transaction pooling) instead — computed from
# POSTGRES_PASSWORD below, nothing to set here. See DATABASE.md.
DATABASE_URL=postgresql://smart:CHANGE_ME@127.0.0.1:5432/smart?schema=public
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://127.0.0.1:6380
KAFKA_BROKERS=127.0.0.1:19092

JWT_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS____
METRICS_SCRAPE_TOKEN=CHANGE_ME_PROM_SCRAPE_TOKEN
CORS_ORIGINS=https://becomesmart.online,https://app.becomesmart.online,https://tpo.becomesmart.online,https://admin.becomesmart.online,https://verify.becomesmart.online
NEXT_PUBLIC_API_URL=https://api.becomesmart.online
PUBLIC_API_URL=https://api.becomesmart.online

AUTH_APP_URL=https://becomesmart.online
STUDENT_APP_URL=https://app.becomesmart.online
TPO_APP_URL=https://tpo.becomesmart.online
ADMIN_APP_URL=https://admin.becomesmart.online

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=smart
S3_ACCESS_KEY=smart
S3_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=smart
MINIO_ROOT_PASSWORD=CHANGE_ME

ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_MONTHLY_CEILING_USD=500

# --- CN-T01 onboarding: GitHub repo picker + LinkedIn identity verification ---
GITHUB_API_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# --- Caddy virtual hosts ---
API_HOST=api.becomesmart.online
STUDENT_HOST=app.becomesmart.online
TPO_HOST=tpo.becomesmart.online
ADMIN_HOST=admin.becomesmart.online
VERIFY_HOST=verify.becomesmart.online
AUTH_HOST=becomesmart.online

# --- DB admin UI (Prisma Studio + Adminer via Caddy, HTTP Basic Auth in front) ---
STUDIO_HOST=studio.becomesmart.online
DB_HOST=db.becomesmart.online
DB_BASIC_AUTH_USER=CHANGE_ME
# bcrypt hash — generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '<password>'
# IMPORTANT: Compose interpolates .env files — escape every literal $ in the hash as $$,
# or the bcrypt salt gets parsed as a variable reference and silently mangled.
DB_BASIC_AUTH_HASH=CHANGE_ME

GRAFANA_PASSWORD=CHANGE_ME
LOG_LEVEL=info
LOG_PRETTY=false
