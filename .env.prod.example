# kvm4 — production (branch: main). Copy to .env.prod on the server.
# Only @brittytino deploys here.

SMART_ENV=prod
COMPOSE_PROJECT_NAME=smart-prod
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Prefer kvm4 Docker Postgres. If using Supabase, a *prod-only* project + pgvector.
DATABASE_URL=postgresql://smart:CHANGE_ME@127.0.0.1:5432/smart?schema=public
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://127.0.0.1:6380
KAFKA_BROKERS=127.0.0.1:19092

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARS____
METRICS_SCRAPE_TOKEN=CHANGE_ME_PROM_SCRAPE_TOKEN
CORS_ORIGINS=https://app.example.com,https://tpo.example.com,https://admin.example.com,https://verify.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
PUBLIC_API_URL=https://api.example.com

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=smart
S3_ACCESS_KEY=smart
S3_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=smart
MINIO_ROOT_PASSWORD=CHANGE_ME

ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_MONTHLY_CEILING_USD=500

API_HOST=api.example.com
STUDENT_HOST=app.example.com
TPO_HOST=tpo.example.com
ADMIN_HOST=admin.example.com
VERIFY_HOST=verify.example.com

GRAFANA_PASSWORD=CHANGE_ME
LOG_LEVEL=info
LOG_PRETTY=false
