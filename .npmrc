# SMART monorepo — pnpm configuration
# Owner: Tino (architect). Changing dependency resolution behaviour affects all 6 engineers.

# Windows PATH often surfaces standalone pnpm 9 before npm's pnpm 11.
# Project `engines.pnpm` hard-fails under 9.x (engine-strict cannot override that),
# so the gate lives in packageManager + scripts/ensure-pnpm.mjs + preinstall --strict.
# These flags let `pnpm run <script>` start under 9.x so ensure-pnpm can re-exec
# via npx pnpm@11.22.0 (or run docker/bash commands directly).
# CI still uses pnpm 11 via packageManager / Corepack.
engine-strict=false
package-manager-strict=false

# Strict module boundaries: a package may only import what it declares in its
# own package.json. This is the mechanism that keeps module ownership honest —
# you cannot accidentally depend on someone else's transitive dependency.
# (pnpm's default symlinked layout already enforces this; we only make sure
# nobody re-enables flat hoisting to "fix" a missing dependency declaration.)
shamefully-hoist=false

# Nest.js and Next.js both need their peer deps resolvable at the app level.
auto-install-peers=true
strict-peer-dependencies=false

# Deterministic installs in CI.
resolution-mode=highest
prefer-workspace-packages=true
link-workspace-packages=true
save-exact=true

# Keep lockfile churn reviewable.
lockfile=true
