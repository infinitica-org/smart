# SMART local / VPS environment
# Copy to `.env` (laptop) or `.env.dev` / `.env.qa` / `.env.prod` on a VPS.
# Never commit filled env files. See docs/delivery/DATABASE.md

SMART_ENV=local
COMPOSE_PROJECT_NAME=smart-local
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# --- data plane (Prisma always uses DATABASE_URL) ---
# Local Docker Postgres. Do not share one project across local/dev/qa/prod.
DATABASE_URL=postgresql://smart:smart@127.0.0.1:5432/smart?schema=public
POSTGRES_PASSWORD=smart
REDIS_URL=redis://127.0.0.1:6380
KAFKA_BROKERS=127.0.0.1:19092

# --- auth (MUST be >= 32 chars) ---
JWT_SECRET=local-dev-jwt-secret-change-me-now!!
METRICS_SCRAPE_TOKEN=

# --- browser origins (comma-separated, no spaces) ---
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost

# Public URL the Next.js apps call. On a VPS this is https://api.yourdomain.com
AUTH_APP_URL=http://localhost:3005
STUDENT_APP_URL=http://localhost:3001
TPO_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3003
AUTH_PORT=3005

# Public URL the Next.js apps call. On a VPS this is https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3005

# --- object storage (MinIO locally, Cloudflare R2 in prod) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=smart
S3_ACCESS_KEY=smart
S3_SECRET_KEY=smartsecret
MINIO_ROOT_USER=smart
MINIO_ROOT_PASSWORD=smartsecret

# --- AI (Anthropic primary, Google GenAI & OpenRouter fallback — validated at boot) ---
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
AI_MONTHLY_CEILING_USD=500

# --- VPS hostnames (Caddy). Use real DNS records pointing at the VPS. ---
API_HOST=api.localhost
STUDENT_HOST=app.localhost
TPO_HOST=tpo.localhost
ADMIN_HOST=admin.localhost
VERIFY_HOST=verify.localhost
AUTH_HOST=auth.localhost
STUDIO_HOST=studio.localhost
DB_BASIC_AUTH_USER=admin
DB_BASIC_AUTH_HASH=

GRAFANA_PASSWORD=smart
LOG_LEVEL=info
LOG_PRETTY=true
